  "releases": [
    {
      "version": "0.6.0",
      "date": "2026-10-20",
      "summary": "将桌面工作台统一更名为 OpenDesk，使用独立应用标识与数据目录。",
      "changes": [
        {
          "featureId": "core.workbench",
          "version": "0.4.0",
          "type": "changed",
          "description": "应用名称、图标、Windows 标识、Python worker、启动环境变量与安装/便携产物统一为 OpenDesk；使用 net.nimda.opendesk 数据目录，自带页签发布新包版本，保留既有模块消息协议兼容。"
        }
      ]
    },
    {
      "version": "0.5.0",
      "date": "2026-10-19",
      "summary": "改善粉色主题的视觉层次，新增四套配色与外观缩略预览。",
      "changes": [
        {
          "featureId": "core.workbench",
          "version": "0.3.0",
          "type": "changed",
          "description": "收敛樱花主题的粉色面积和强调色，区分普通边框、控件边框与按钮文字；新增海盐蓝、松石绿、暖砂岩、石墨夜以及同源配色预览，保持主题持久化和旧页签明暗回退兼容。"
        }
      ]
    },
    {
      "version": "0.4.0",
      "date": "2026-10-19",
      "summary": "新增沿用 NimdaClaw 配色的樱花浅色外观。",
      "changes": [
        {
          "featureId": "core.workbench",
          "version": "0.2.0",
          "type": "changed",
          "description": "新增樱花浅色主题、即时预览与持久化，宿主和新版页签同步外观；主题消息保持旧页签兼容，原有系统、浅色和深色选择继续可用。"
        }
      ]
    },
    {
      "version": "0.3.0",
      "date": "2026-10-19",
      "summary": "新增可导入的独立页签包、多版本选择和测试页签。",
      "changes": [
        {
          "version": "0.1.0",
          "description": "App自带模块包与本地.ndpkg导入统一管理，失败保留原件，多版本并存和选择，独立页面与worker，加入测试页签。",
          "featureId": "core.module-packages",
          "type": "added"
        }
      ]
    },
    {
      "version": "0.2.1",
      "date": "2026-10-18",
      "summary": "修复 Windows 构建时 Git 仓库路径识别。",
      "changes": [
        {
          "featureId": "core.versioning",
          "version": "0.1.1",
          "type": "fixed",
          "description": "以目录的文件系统身份识别 Git 根目录，兼容 Windows 路径大小写与短路径别名；继续拒绝把嵌套源码目录误认成父仓库，并补充回归检查。"
        }
      ]
    },
    {
      "version": "0.2.0",
      "date": "2026-10-18",
      "summary": "新增塔防山贼助手，建立应用与功能独立版本追踪。",
      "changes": [
        {
          "featureId": "tower.save-reader",
          "version": "0.1.0",
          "type": "added",
          "description": "只读最近或指定存档，识别当前城市、人物、已摆灵物与仓库；核实游戏规则和物品绑定。"
        },
        {
          "featureId": "tower.tribulation-plan",
          "version": "0.1.0",
          "type": "added",
          "description": "优先达到可用灵物的最高渡劫灵气，再减少人物、置物台及关联设施的搬动；输出有序迁移步骤和最优性说明。"
        },
        {
          "featureId": "tower.map-details",
          "version": "0.1.0",
          "type": "added",
          "description": "显示前后地图、真实人物与物品图标、灵气和迁移编号；点击查看职业、穿戴、五行及灵物更换，支持同格选择和 SVG 导出。"
        },
        {
          "featureId": "core.versioning",
          "version": "0.1.0",
          "type": "added",
          "description": "应用与功能分别采用语义版本；统一同步构建版本，生成更新记录、查询功能迭代并显示构建时 Git 提交与工作树状态。"
        }
      ]
    },
    {
      "version": "0.1.0",
      "date": "2026-10-15",
      "summary": "初始化 NimdaDesk 桌面工作台框架。",
      "changes": [
        {
          "featureId": "core.workbench",
          "version": "0.1.0",
          "type": "added",
          "description": "建立 Tauri、Vue 与 Python worker 的独立模块架构，提供主题、设置、运行诊断、托盘、快捷键及受控通信。"
        }
      ]
    }
  ]
}
